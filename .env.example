# --- Database ---
DB_PASSWORD=change-me
POSTGRES_DB=plm
POSTGRES_USER=plm
DATABASE_URL=postgresql+psycopg://plm:change-me@localhost:5432/plm
TEST_DATABASE_URL=postgresql+psycopg://plm:plm@localhost:5432/plm_test

# --- Security ---
# generate with: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ACCESS_MINUTES=30

# Bootstrap admin (created on first API start when the users table is empty).
# NOTE: the email must pass login validation — reserved TLDs like .local are rejected.
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Object storage for files (local; S3-compatible later) ---
STORAGE_DIR=/data/files

# --- AI layer (phase M7) ---
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=sk-change-me-litellm-master-key
LLM_MODEL=plm-chat
LITELLM_MASTER_KEY=sk-change-me
# AI agent (logs in against the PLM API with its own user)
PLM_API_URL=http://localhost:8000
PLM_AGENT_EMAIL=agent@example.com
PLM_AGENT_PASSWORD=change-me
