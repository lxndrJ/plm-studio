# --- Datenbank ---
DB_PASSWORD=change-me
POSTGRES_DB=plm
POSTGRES_USER=plm
DATABASE_URL=postgresql+psycopg://plm:change-me@localhost:5432/plm
TEST_DATABASE_URL=postgresql+psycopg://plm:plm@localhost:5432/plm_test

# --- Security ---
# Erzeugen mit: openssl rand -hex 32
JWT_SECRET=change-me
JWT_ACCESS_MINUTES=30

# Bootstrap-Admin (wird beim ersten API-Start angelegt, wenn users leer ist)
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me

# --- Object storage fuer Dateien (lokal; spaeter S3-kompatibel) ---
STORAGE_DIR=/data/files

# --- KI-Layer (Phase M7) ---
OPENAI_BASE_URL=http://litellm:4000/v1
OPENAI_API_KEY=sk-change-me-litellm-master-key
LLM_MODEL=plm-chat
LITELLM_MASTER_KEY=sk-change-me
